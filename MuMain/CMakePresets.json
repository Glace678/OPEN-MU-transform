{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86",
      "description": "Standard build without editor features",
      "inherits": "windows-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "toolchainFile": "${sourceDir}/toolchain-x86.cmake",
      "cacheVariables": {
        "ENABLE_EDITOR": "OFF"
      }
    },
    {
      "name": "windows-x86-mueditor",
      "displayName": "Windows x86 MuEditor",
      "description": "Build with editor features",
      "inherits": "windows-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "toolchainFile": "${sourceDir}/toolchain-x86.cmake",
      "cacheVariables": {
        "ENABLE_EDITOR": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Standard build without editor features",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolchainFile": "${sourceDir}/toolchain-x64.cmake",
      "cacheVariables": {
        "ENABLE_EDITOR": "OFF"
      }
    },
    {
      "name": "windows-x64-mueditor",
      "displayName": "Windows x64 MuEditor",
      "description": "Build with editor features",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolchainFile": "${sourceDir}/toolchain-x64.cmake",
      "cacheVariables": {
        "ENABLE_EDITOR": "ON"
      }
    },
    {
      "name": "windows-x86-tidy",
      "displayName": "Windows x86 + clang-tidy",
      "description": "x86 build with clang-tidy run over the engine sources (advisory findings, never fails the build)",
      "inherits": "windows-x86",
      "cacheVariables": {
        "ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "windows-x64-tidy",
      "displayName": "Windows x64 + clang-tidy",
      "description": "x64 build with clang-tidy run over the engine sources (advisory findings, never fails the build)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "windows-x64-asan",
      "displayName": "Windows x64 + AddressSanitizer",
      "description": "x64 build under MSVC AddressSanitizer (MSVC ASan has no 32-bit support)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-debug",
      "displayName": "x86 Debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug"
    },
    {
      "name": "windows-x86-release",
      "displayName": "x86 Release",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-mueditor-debug",
      "displayName": "x86 MuEditor Debug",
      "configurePreset": "windows-x86-mueditor",
      "configuration": "Debug"
    },
    {
      "name": "windows-x86-mueditor-release",
      "displayName": "x86 MuEditor Release",
      "configurePreset": "windows-x86-mueditor",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "displayName": "x64 Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "displayName": "x64 Release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-mueditor-debug",
      "displayName": "x64 MuEditor Debug",
      "configurePreset": "windows-x64-mueditor",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-mueditor-release",
      "displayName": "x64 MuEditor Release",
      "configurePreset": "windows-x64-mueditor",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-tidy-release",
      "displayName": "x86 + clang-tidy Release",
      "configurePreset": "windows-x86-tidy",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-tidy-release",
      "displayName": "x64 + clang-tidy Release",
      "configurePreset": "windows-x64-tidy",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-asan-release",
      "displayName": "x64 + AddressSanitizer Release",
      "configurePreset": "windows-x64-asan",
      "configuration": "Release"
    }
  ]
}
