{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "buildProfileFields": {
        // Same pairing key / server address as the Android APKs (43 base64url chars).
        // Replace BOTH before building: MOBILE_PACKAGE_KEY must match the server and
        // the GM app, and DEFAULT_SERVER_ADDRESS must be THIS machine's LAN IPv4
        // (localhost or a private address per RFC1918). The address below is only a
        // neutral placeholder -- it is not a real host.
        "MOBILE_PACKAGE_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "DEFAULT_SERVER_ADDRESS": "192.168.0.2"
      }
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": [
        // MU_REPOSITORY_ROOT defaults to the shared MuMain checkout next to this
        // OpenMU-HarmonyOS folder (resolved by cpp/CMakeLists.txt). Only set this
        // if MuMain lives elsewhere, and use an ABSOLUTE path:
        // "-DMU_REPOSITORY_ROOT=D:/openmu自用/MuMain",
        // gl4es for OHOS (desktop GL -> GLES); build from the gl4es source:
        // "-DMU_OHOS_GL4ES_ROOT=D:/path/to/gl4es",
        "-DOHOS=ON",
        "-DOHOS_ARCH=arm64-v8a"
      ],
      "cppFlags": "-std=c++20",
      "abiFilters": ["arm64-v8a"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": { "enable": false }
        }
      }
    }
  ],
  "targets": [
    { "name": "default" }
  ]
}
