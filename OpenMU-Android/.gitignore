/.gradle/
/.idea/
/.cxx/
/**/build/
/local.properties

# Release output and staging.
/release/*.apk
/release/*.sha256
/OpenMU-安卓手机版-可安装/
/OpenMU-安卓手机版-可安装.pending/
/OpenMU-安卓手机版-可安装.backup/

# The ~740 MB game data archive. Built by Build-AndroidPackage.ps1 from
# MuMain/src/bin; never committed.
/game-app/src/main/assets/game-data.zip

# Prebuilt native libraries. Produced from the MuMain CMake build, staged here
# by Build-AndroidPackage.ps1, and large enough that committing them would make
# the repo unusable.
/native/

# NativeAOT .NET protocol library build. Regenerated by
# build-clientlibrary-android.sh.
/nativeaot/build/
/nativeaot/publish.log
/nativeaot/verify.txt
/nativeaot/expected-exports.txt
/nativeaot/actual-exports.txt
/nativeaot/missing-exports.txt

# Packaged server trees -- multi-GB builds, produced by the OpenMU publish step.
/server-build/
/server-build-next/

# Scratch test output.
/test-build/

# The mobile pairing key. Build-AndroidPackage.ps1 reads it from here and
# validates it, but the value is a live secret that derives the mobile account
# and authenticates the GM API -- it must never be committed. Keep it out of the
# tree (or in a DPAPI-protected blob) and pass it in at build time instead.
/mobile-server-settings.json

# Hand-edited backups of scripts are never the source of truth.
*.bak
*.bak-encoding
*.orig
*.rej
