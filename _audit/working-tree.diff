+# Write credentials to a temporary, user-only file instead of the child process
+# environment block: environment variables are readable by every process of the
+# same user, whereas the file ACL below restricts access to this user.
+$credentialDirectory = Join-Path $Root 'Data\Keys'
+$credentialPath = Join-Path $credentialDirectory ('game-login-' + [Guid]::NewGuid().ToString('N') + '.tmp')
+$p = $null
+try
