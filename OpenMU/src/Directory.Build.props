<?xml version="1.0" encoding="utf-8"?>
<Project>

    <!-- DEP-009: reproducible restore via NuGet lock file; CI builds are deterministic. -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NuGetLockFilePath>packages.lock.json</NuGetLockFilePath>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Label="commom configuration code style.">
        
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        
    </ItemGroup>

    <Choose>
        <When Condition="Exists('../SharedAssemblyInfo.cs')">
            <ItemGroup>
                <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
                <Compile Include="..\SharedGlobalUsings.cs" Link="SharedGlobalUsings.cs" />
                <None Include="..\.editorconfig" Link=".editorconfig" />
            </ItemGroup>
            <ItemGroup>
                <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <Compile Include="..\..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
                <Compile Include="..\..\SharedGlobalUsings.cs" Link="SharedGlobalUsings.cs" />
                <None Include="..\..\.editorconfig" Link=".editorconfig" />
            </ItemGroup>
            <ItemGroup>
                <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
            </ItemGroup>
        </Otherwise>
    </Choose>
</Project>