<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <WarningsAsErrors>nullable;CS4014</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LocalLauncher/*.cs"
             Exclude="../LocalLauncher/Program.cs;../LocalLauncher/LauncherForm.cs;../LocalLauncher/AdministratorPasswordDialog.cs;../LocalLauncher/StartupRegistration.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>
