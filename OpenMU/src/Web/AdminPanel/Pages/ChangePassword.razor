@page "/change-password"
@layout MUnique.OpenMU.Web.AdminPanel.Components.Layout.LoginLayout
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Localization
@using MUnique.OpenMU.Web.AdminPanel.Properties
@inject IStringLocalizer<SelfServiceResources> Text
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<PageTitle>OpenMU: @Text["ChangePasswordTitle"]</PageTitle>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 card-title mb-3">@Text["ChangePasswordHeading"]</h2>
        <p class="text-secondary small">
            @Text["ChangePasswordDescription"]
        </p>
        <EditForm Model="@this._input" OnValidSubmit="@this.SubmitAsync" FormName="game-change-password">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="change-name">@Text["AccountNameLabel"]</label>
                <InputText id="change-name" class="form-control" autocomplete="username" @bind-Value="@this._input.LoginName" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="change-old-password">@Text["CurrentPasswordLabel"]</label>
                <InputText id="change-old-password" type="password" class="form-control" autocomplete="current-password" @bind-Value="@this._input.OldPassword" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="change-new-password">@Text["NewPasswordLabel"]</label>
                <InputText id="change-new-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="@this._input.NewPassword" />
                <div class="form-text">@Text["NewPasswordHelp"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="change-confirm">@Text["ConfirmNewPasswordLabel"]</label>
                <InputText id="change-confirm" type="password" class="form-control" autocomplete="new-password" @bind-Value="@this._input.ConfirmPassword" />
            </div>
            @if (this._message is { } message)
            {
                <div class="alert @(this._success ? "alert-success" : "alert-danger") py-2" role="alert">@message</div>
            }
            <button type="submit" class="btn btn-primary w-100" disabled="@this._isBusy">@Text["ChangePasswordButton"]</button>
        </EditForm>
        <div class="mt-3 d-flex flex-wrap justify-content-between gap-2">
            <a class="small" href="login">@Text["BackToLoginLink"]</a>
            <a class="small" href="reset-password">@Text["ForgotPasswordLink"]</a>
            <a class="small" href="register">@Text["RegisterNewAccountLink"]</a>
        </div>
    </div>
</div>

@code {
    private InputModel _input = new();
    private bool _isBusy;
    private bool _success;
    private string? _message;
    private IJSObjectReference? _selfServiceModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this._selfServiceModule = await this.JsRuntime
                .InvokeAsync<IJSObjectReference>("import", "./_content/MUnique.OpenMU.Web.AdminPanel/js/account-self-service.js")
                .ConfigureAwait(true);
        }
    }

    private async Task SubmitAsync()
    {
        this._isBusy = true;
        this._message = null;
        try
        {
            if (this._selfServiceModule is null)
            {
                this._success = false;
                this._message = this.Text["RegistrationPageNotReady"].Value;
                return;
            }

            var result = await this._selfServiceModule.InvokeAsync<RegistrationResult>(
                "postJson",
                "api/registration/change-password",
                new
                {
                    LoginName = this._input.LoginName?.Trim(),
                    this._input.OldPassword,
                    NewPassword = this._input.NewPassword,
                    ConfirmNewPassword = this._input.ConfirmPassword,
                }).ConfigureAwait(true);
            this._success = result?.Success ?? false;
            this._message = result?.Message ?? this.Text["ChangeFailed"].Value;
            if (this._success)
            {
                this._input.OldPassword = string.Empty;
                this._input.NewPassword = string.Empty;
                this._input.ConfirmPassword = string.Empty;
            }
        }
        catch (Exception)
        {
            this._success = false;
            this._message = this.Text["CannotConnect"].Value;
        }
        finally
        {
            this._isBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (this._selfServiceModule is { } module)
        {
            this._selfServiceModule = null;
            try
            {
                await module.DisposeAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already gone.
            }
        }

        GC.SuppressFinalize(this);
    }

    private sealed class InputModel
    {
        [SelfServiceRequired("RequiredAccountName")]
        public string? LoginName { get; set; }

        [SelfServiceRequired("RequiredCurrentPassword")]
        public string? OldPassword { get; set; }

        [SelfServiceRequired("RequiredNewPassword")]
        public string? NewPassword { get; set; }

        [SelfServiceRequired("RequiredNewConfirmPassword")]
        public string? ConfirmPassword { get; set; }
    }

    private sealed record RegistrationResult(bool Success, string Code, string Message);
}
