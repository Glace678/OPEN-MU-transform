@page "/reset-password"
@layout MUnique.OpenMU.Web.AdminPanel.Components.Layout.LoginLayout
@attribute [AllowAnonymous]
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Localization
@using MUnique.OpenMU.Web.AdminPanel.API
@using MUnique.OpenMU.Web.AdminPanel.Properties
@inject IStringLocalizer<SelfServiceResources> Text
@inject IJSRuntime JsRuntime
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>OpenMU: @Text["ResetPasswordTitle"]</PageTitle>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 card-title mb-3">@Text["ResetPasswordHeading"]</h2>
        <p class="text-secondary small">@Text["ResetPasswordDescription"]</p>
        @if (this.LocalResetEnabled)
        {
            <div class="alert alert-warning py-2" role="status">@Text["LocalPasswordResetWarning"]</div>
        }
        <EditForm Model="@this._input" OnValidSubmit="@this.SubmitAsync" FormName="game-reset">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />
                <div class="mb-3">
                    <label class="form-label" for="reset-name">@Text["AccountNameLabel"]</label>
                    <InputText id="reset-name" class="form-control" autocomplete="username" @bind-Value="@this._input.LoginName" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reset-recovery-code">@Text["RecoveryCodeLabel"]</label>
                    <InputText id="reset-recovery-code" type="password" class="form-control font-monospace" autocomplete="off" spellcheck="false" @bind-Value="@this._input.RecoveryCode" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reset-password">@Text["NewPasswordLabel"]</label>
                    <InputText id="reset-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="@this._input.NewPassword" />
                    <div class="form-text">@Text["NewPasswordHelp"]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reset-confirm">@Text["ConfirmNewPasswordLabel"]</label>
                    <InputText id="reset-confirm" type="password" class="form-control" autocomplete="new-password" @bind-Value="@this._input.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@this._isBusy">@Text["ResetPasswordButton"]</button>
        </EditForm>
        <details class="mt-3">
            <summary class="small">@Text["RecoveryIssueTitle"]</summary>
            <EditForm Model="@this._issueInput" OnValidSubmit="@this.IssueCodeAsync" FormName="game-recovery-code" class="mt-3">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />
                <div class="mb-3">
                    <label class="form-label" for="issue-name">@Text["AccountNameLabel"]</label>
                    <InputText id="issue-name" class="form-control" autocomplete="username" @bind-Value="@this._issueInput.LoginName" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="issue-password">@Text["CurrentPasswordLabel"]</label>
                    <InputText id="issue-password" type="password" class="form-control" autocomplete="current-password" @bind-Value="@this._issueInput.CurrentPassword" />
                </div>
                <button type="submit" class="btn btn-outline-secondary w-100" disabled="@this._isBusy">@Text["IssueRecoveryCodeButton"]</button>
            </EditForm>
        </details>
        @if (this._message is { } message)
        {
            <div class="alert @(this._success ? "alert-success" : "alert-danger") mt-3 py-2" role="alert">@message</div>
        }
        @if (this._recoveryCode is { } recoveryCode)
        {
            <label class="form-label" for="replacement-recovery-code">@Text["RecoveryCodeLabel"]</label>
            <textarea id="replacement-recovery-code" class="form-control font-monospace" readonly rows="3" autocomplete="off" spellcheck="false">@recoveryCode</textarea>
            <p class="small text-warning mt-2">@Text["RecoveryCodeNotice"]</p>
        }
        <div class="mt-3 d-flex justify-content-between">
            <a class="small" href="login">@Text["BackToLoginLink"]</a>
            <a class="small" href="change-password">@Text["ChangePasswordLink"]</a>
            <a class="small" href="register">@Text["RegisterNewAccountLink"]</a>
        </div>
    </div>
</div>

@code {
    private InputModel _input = new();
    private IssueInputModel _issueInput = new();
    private bool _isBusy;
    private bool _success;
    private string? _message;
    private string? _recoveryCode;
    private IJSObjectReference? _selfServiceModule;

    private bool LocalResetEnabled => bool.TryParse(
        this.Configuration["AccountSelfService:AllowLocalPasswordReset"], out var enabled) && enabled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this._selfServiceModule = await this.JsRuntime
                .InvokeAsync<IJSObjectReference>("import", "./_content/MUnique.OpenMU.Web.AdminPanel/js/account-self-service.js")
                .ConfigureAwait(true);
        }
    }

    private async Task SubmitAsync()
    {
        this._isBusy = true;
        this._message = null;
        try
        {
            if (this._selfServiceModule is null)
            {
                this._success = false;
                this._message = this.Text["RegistrationPageNotReady"].Value;
                return;
            }

            var result = await this._selfServiceModule.InvokeAsync<AccountRegistrationResponse>(
                "postJson",
                "api/registration/reset-password",
                new
                {
                    LoginName = this._input.LoginName?.Trim(),
                    NewPassword = this._input.NewPassword,
                    ConfirmNewPassword = this._input.ConfirmPassword,
                    this._input.RecoveryCode,
                }).ConfigureAwait(true);
            this._success = result?.Success ?? false;
            this._message = result?.Message ?? this.Text["ResetFailed"].Value;
            if (this._success)
            {
                this._recoveryCode = result?.RecoveryCode;
                this._input = new InputModel();
            }
        }
        catch (Exception)
        {
            this._success = false;
            this._message = this.Text["CannotConnect"].Value;
        }
        finally
        {
            this._isBusy = false;
        }
    }

    private async Task IssueCodeAsync()
    {
        this._isBusy = true;
        this._message = null;
        try
        {
            if (this._selfServiceModule is null)
            {
                this._success = false;
                this._message = this.Text["RegistrationPageNotReady"].Value;
                return;
            }

            var result = await this._selfServiceModule.InvokeAsync<AccountRegistrationResponse>(
                "postJson", "api/registration/recovery-code", new
                {
                    LoginName = this._issueInput.LoginName?.Trim(),
                    this._issueInput.CurrentPassword,
                }).ConfigureAwait(true);
            this._success = result?.Success ?? false;
            this._message = result?.Message ?? this.Text["RecoveryIssueFailed"].Value;
            if (this._success)
            {
                this._recoveryCode = result?.RecoveryCode;
                this._issueInput = new IssueInputModel();
            }
        }
        catch (Exception)
        {
            this._success = false;
            this._message = this.Text["CannotConnect"].Value;
        }
        finally
        {
            this._isBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (this._selfServiceModule is { } module)
        {
            this._selfServiceModule = null;
            try
            {
                await module.DisposeAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already gone.
            }
        }

        GC.SuppressFinalize(this);
    }

    private sealed class InputModel
    {
        [SelfServiceRequired("RequiredAccountName")]
        public string? LoginName { get; set; }

        [SelfServiceRequired("RequiredRecoveryCode")]
        public string? RecoveryCode { get; set; }

        [SelfServiceRequired("RequiredNewPassword")]
        public string? NewPassword { get; set; }

        [SelfServiceRequired("RequiredNewConfirmPassword")]
        public string? ConfirmPassword { get; set; }
    }

    private sealed class IssueInputModel
    {
        [SelfServiceRequired("RequiredAccountName")]
        public string? LoginName { get; set; }

        [SelfServiceRequired("RequiredCurrentPassword")]
        public string? CurrentPassword { get; set; }
    }
}
