# Copy this file to .env and fill in every value before running
# `docker compose --env-file .env ...`. quick-start generates a complete .env
# with strong random secrets (deploy/quick-start.sh or quick-start.ps1).

# --- PostgreSQL -----------------------------------------------------------
# Applied to the database container only when the dbdata volume is created
# (changing it later does NOT change an existing database; run ALTER ROLE first).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=openmu

# Credentials used by the game servers for the same database.
# Must match POSTGRES_* on an already initialized volume.
DB_ADMIN_USER=postgres
DB_ADMIN_PW=change-me-to-a-strong-password
DB_NAME=openmu

# --- Redis / MinIO --------------------------------------------------------
# Expanded inside dapr-components by daprd (${{REDIS_PASSWORD}} placeholder).
REDIS_PASSWORD=change-me-to-a-strong-password
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-to-a-strong-secret

# --- RabbitMQ (Dapr pubsub) ----------------------------------------------
# Both are REQUIRED: compose refuses to start when either is empty.
# RABBITMQ_DEFAULT_USER/PASS apply to the rabbit container on first volume
# creation; daprd expands the component placeholders from its environment.
RABBITMQ_USER=change-me-rabbit-user
RABBITMQ_PASSWORD=change-me-to-a-strong-rabbit-password

# --- Admin panel bootstrap user ------------------------------------------
# Both are REQUIRED: compose refuses to start when either is empty.
# After first start the panel is reachable with this user, so set strong
# values here. quick-start generates them when left to it.
OPENMU_ADMIN_USER=
OPENMU_ADMIN_PASSWORD=
# Optional base32 TOTP secret if the bootstrap user must require 2FA.
OPENMU_ADMIN_TOTP_SECRET=

# --- Optional Dapr app API token -----------------------------------------
# When set, the same value must be configured for the app and its daprd
# sidecar (Dapr app API token authentication). Inter-service calls already
# stay internal via the shared sidecar network namespace (loopback).
APP_API_TOKEN=
